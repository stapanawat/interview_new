# Copy this file to .env and fill in production values. Never commit .env.
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# Use a long random value in production.
JWT_SECRET=replace-with-a-long-random-secret-before-production
JWT_EXPIRES_IN=8h

# Example: postgresql://user:password@host:5432/database_name
DATABASE_URL=

# Supabase (server-side only; never expose the service-role key in VITE_* variables)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Required for /api/internal/reminders, called by an external scheduler every 15 minutes.
CRON_SECRET=replace-with-a-long-random-secret

# LINE Messaging API credentials
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF / LINE Login (must be under the same Provider as the Messaging API channel)
# VITE_LIFF_ID is public. Keep any LINE Login secret server-side only.
VITE_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=

REMINDER_CRON_ENABLED=true
LOG_LEVEL=info
